# Google Sheets lead sync — Apps Script "Web app" URL (scripts/google-sheets-webhook.gs).
# Every completed submission is POSTed here and appended to the "Agency Tool Leads" tab.
LEAD_WEBHOOK_URL=

# Upstash Redis (Vercel Marketplace integration) — lead persistence + admin export.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret for GET /api/leads?token=...
ADMIN_TOKEN=

# Mailgun — powers both the internal "new lead" alert and the respondent's report email.
# Leave unset locally and nothing is sent (a warning is logged instead).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# "us" (default) or "eu" — must match the region the domain was created in.
MAILGUN_REGION=us
# Sender shown to recipients. Must be on MAILGUN_DOMAIN. Defaults to postmaster@MAILGUN_DOMAIN.
MAIL_FROM="SPEEDXMEDIA Agency Health Check <noreply@mg.speedxmedia.com>"
# Comma-separated internal recipients for the new-lead alert. Defaults to spencer@ and leads@speedxmedia.com.
LEAD_NOTIFY_TO=spencer@speedxmedia.com,leads@speedxmedia.com
